---
interface Props {
	bashLabel?: string;
	tsLabel?: string;
}
const { bashLabel = 'bsh', tsLabel = 'ts' } = Astro.props;
---

<div class="switcher" data-codeswitcher>
	<div class="tabs" role="tablist" aria-label="Code variant">
		<button
			type="button"
			class="tab"
			data-lang="bash"
			role="tab"
			aria-selected="true"
		>{bashLabel}</button>
		<button
			type="button"
			class="tab"
			data-lang="ts"
			role="tab"
			aria-selected="false"
		>{tsLabel}</button>
	</div>
	<div class="grid">
		<div class="pane pane-bash" data-pane="bash" role="tabpanel">
			<div class="pane-label" aria-hidden="true">bash</div>
			<slot name="bash" />
		</div>
		<div class="pane pane-ts" data-pane="ts" role="tabpanel" hidden>
			<div class="pane-label" aria-hidden="true">typescript</div>
			<slot name="ts" />
		</div>
	</div>
</div>

<style>
	.switcher {
		margin: 1.25em 0;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--code-bg);
		overflow: hidden;
	}
	.tabs {
		display: none;
		background: var(--bg-elevated);
		border-bottom: 1px solid var(--border);
		padding: 0.3rem 0.4rem;
		gap: 0.25rem;
	}
	.tab {
		background: transparent;
		border: 0;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		padding: 0.4rem 0.85rem;
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.tab:hover {
		color: var(--fg);
	}
	.tab[aria-selected="true"] {
		background: var(--bg-soft);
		color: var(--accent);
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.pane {
		position: relative;
		min-width: 0;
	}
	.pane:first-child {
		border-right: 1px solid var(--border);
	}
	.pane-label {
		position: absolute;
		top: 0.5rem;
		right: 0.8rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--fg-faint);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		pointer-events: none;
		z-index: 1;
	}
	.switcher :global(pre) {
		margin: 0;
		border: 0;
		border-radius: 0;
		background: var(--code-bg);
		padding: 1.1rem 1.2rem;
	}

	/* Tab mode: <1024px */
	@media (max-width: 1023.98px) {
		.tabs {
			display: flex;
		}
		.grid {
			grid-template-columns: 1fr;
		}
		.pane:first-child {
			border-right: 0;
		}
		.pane[hidden] {
			display: none;
		}
		.pane-label {
			display: none;
		}
	}
</style>

<script>
	const KEY = 'crust-codeswitcher-lang';
	type Lang = 'bash' | 'ts';

	const valid = (v: string | null): v is Lang => v === 'bash' || v === 'ts';
	const getStored = (): Lang => {
		try {
			const v = localStorage.getItem(KEY);
			return valid(v) ? v : 'bash';
		} catch {
			return 'bash';
		}
	};

	const apply = (root: HTMLElement, lang: Lang) => {
		for (const tab of root.querySelectorAll<HTMLButtonElement>('.tab')) {
			const isActive = tab.dataset.lang === lang;
			tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
		}
		for (const pane of root.querySelectorAll<HTMLElement>('.pane')) {
			const isActive = pane.dataset.pane === lang;
			if (isActive) pane.removeAttribute('hidden');
			else pane.setAttribute('hidden', '');
		}
	};

	const setLang = (lang: Lang) => {
		try {
			localStorage.setItem(KEY, lang);
		} catch {
			/* noop */
		}
		for (const root of document.querySelectorAll<HTMLElement>('[data-codeswitcher]')) {
			apply(root, lang);
		}
	};

	const initial = getStored();
	for (const root of document.querySelectorAll<HTMLElement>('[data-codeswitcher]')) {
		apply(root, initial);
		for (const tab of root.querySelectorAll<HTMLButtonElement>('.tab')) {
			tab.addEventListener('click', () => {
				const lang = tab.dataset.lang;
				if (valid(lang ?? null)) setLang(lang as Lang);
			});
		}
	}
</script>
