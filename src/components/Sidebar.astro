---
import { href as withBase, routePath } from '../lib/site';

// Compare against base-stripped routes; the hrefs below stay written as plain
// site-root paths and get the base applied at render.
const path = routePath(Astro.url.pathname).replace(/\/$/, '');

const sections: { title: string; links: { label: string; href: string }[] }[] = [
	{
		title: 'Getting started',
		links: [
			{ label: 'Overview', href: '/docs/' },
			{ label: 'Intro', href: '/docs/intro/' },
			{ label: 'Quickstart', href: '/docs/quickstart/' },
			{ label: 'npm packages', href: '/docs/npm-packages/' },
			{ label: 'DB drivers', href: '/docs/db-drivers/' },
		],
	},
	{
		title: 'Concepts',
		links: [
			{ label: 'Pipe shorthand vs TypeScript', href: '/docs/pipes-vs-typescript/' },
			{ label: 'Compiled binary vs npm module', href: '/docs/binary-vs-npm/' },
		],
	},
	{
		title: 'AI agent skills',
		links: [
			{ label: 'Overview', href: '/docs/agent-skills/' },
			{ label: 'crust-pipelines', href: '/docs/agent-skills/pipelines/' },
			{ label: 'crust-api-testing', href: '/docs/agent-skills/api-testing/' },
			{ label: 'crust-load-testing', href: '/docs/agent-skills/load-testing/' },
			{ label: 'crust-mock-server', href: '/docs/agent-skills/mock-server/' },
			{ label: 'crust-procs', href: '/docs/agent-skills/procs/' },
		],
	},
	{
		title: 'Recipes',
		links: [
			{ label: 'All recipes', href: '/docs/recipes/' },
			{ label: 'Stress testing', href: '/docs/recipes/stress-testing/' },
			{ label: 'CI load gates', href: '/docs/recipes/ci-load-gates/' },
			{ label: 'Mock server (OpenAPI)', href: '/docs/recipes/mock-server/' },
			{ label: 'Verify web links + SEO', href: '/docs/recipes/verify-web-links/' },
			{ label: 'API smoke tests', href: '/docs/recipes/api-smoke-tests/' },
			{ label: 'Generated negative fixtures', href: '/docs/recipes/gen-fixtures/' },
			{ label: 'One dev tail', href: '/docs/recipes/dev-tail/' },
			{ label: 'Log mining', href: '/docs/recipes/log-mining/' },
			{ label: 'Heap snapshots in tests', href: '/docs/recipes/heap-snapshots/' },
		],
	},
];

const isActive = (href: string) => {
	const clean = href.replace(/\/$/, '');
	return path === clean;
};
---

<aside class="sidebar" aria-label="Docs navigation">
	<nav>
		{
			sections.map((section) => (
				<div class="section">
					<h4>{section.title}</h4>
					<ul>
						{section.links.map((l) => (
							<li>
								<a href={withBase(l.href)} class:list={[{ active: isActive(l.href) }]}>
									{l.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</nav>
</aside>

<style>
	.sidebar {
		font-size: 0.95rem;
	}
	.sidebar nav {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.section h4 {
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-muted);
		font-weight: 600;
		margin: 0 0 0.6rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	li {
		margin: 0;
	}
	a {
		display: block;
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
		color: var(--fg-muted);
		border-left: 2px solid transparent;
	}
	a:hover {
		color: var(--fg);
		background: var(--bg-soft);
	}
	a.active {
		color: var(--accent);
		background: var(--bg-soft);
		border-left-color: var(--accent);
		font-weight: 500;
	}
</style>
