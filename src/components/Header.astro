---
import { href, isPublic, REPO_URL, routePath } from '../lib/site';

// routePath strips the configured base: Astro.url.pathname includes it, so a
// subpath deploy would otherwise make every startsWith('/docs') check false and
// silently drop the active state from the whole nav.
const path = routePath(Astro.url.pathname);
const isActive = (prefix: string) =>
	prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<header class="site-header">
	<div class="container bar">
		<a href={href('/')} class="brand" aria-label="Crust home">
			<span class="mark" aria-hidden="true">🥖</span>
			<span class="wordmark">crust</span>
		</a>
		<nav class="nav" aria-label="Primary">
			<a href={href('/docs/intro/')} class:list={[{ active: isActive('/docs') && !isActive('/docs/recipes') }]}>Docs</a>
			<a href={href('/docs/quickstart/')} class:list={[{ active: path === '/docs/quickstart' }]}>Quickstart</a>
			<a href={href('/docs/recipes/')} class:list={[{ active: isActive('/docs/recipes') }]}>Recipes</a>
			{isPublic && (
				<a href={REPO_URL} class="github" aria-label="crust on GitHub">
					<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
					</svg>
				</a>
			)}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(26, 18, 11, 0.78);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 60px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--fg);
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: -0.01em;
	}
	.brand:hover {
		color: var(--accent);
	}
	.mark {
		font-size: 1.35rem;
		line-height: 1;
	}
	.wordmark {
		font-family: var(--font-mono);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--fg-muted);
		padding: 0.5rem 0.85rem;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 500;
	}
	.nav a:hover {
		color: var(--fg);
		background: var(--bg-soft);
	}
	.nav a.active {
		color: var(--accent);
	}
	.github svg {
		opacity: 0.7;
	}
	@media (max-width: 600px) {
		.nav a {
			padding: 0.5rem 0.55rem;
			font-size: 0.9rem;
		}
		.nav .github {
			display: none;
		}
	}
</style>
